{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mandarin cards data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "characters": { "type": "array", "items": { "$ref": "#/definitions/entry" } },
    "sentences": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hanzi", "pinyin", "italian"],
      "properties": {
        "hanzi": { "type": "string", "minLength": 1, "description": "Simplified characters. Must be unique within its array." },
        "pinyin": { "type": "string", "minLength": 1, "pattern": "^[^0-9]+$", "description": "Pinyin with tone marks (nǐ), not numbers (ni3)." },
        "italian": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Italian meanings; the first one is primary." },
        "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "pattern": "^[^,]+$" }, "description": "Case-insensitive, e.g. hsk1, lesson-01, greetings." },
        "notes": { "type": "string" },
        "traditional": { "type": "string", "minLength": 1, "description": "Traditional form, if different." }
      }
    }
  }
}
