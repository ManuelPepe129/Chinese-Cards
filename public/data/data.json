  "sentences": [
    { "hanzi": "你好吗？", "pinyin": "Nǐ hǎo ma?", "italian": ["Come stai?"], "tags": ["lezione-1a"] },
    { "hanzi": "我很好。你呢？", "pinyin": "Wǒ hěn hǎo. Nǐ ne?", "italian": ["Sto molto bene. E tu?"], "tags": ["lezione-1a"] },
    { "hanzi": "你好！我是马可。", "pinyin": "Nǐ hǎo! Wǒ shì Mǎkě.", "italian": ["Ciao! Sono Marco."], "tags": ["lezione-1b"] },
    { "hanzi": "我不是白老师。", "pinyin": "Wǒ bú shì Bái lǎoshī.", "italian": ["Non sono l'insegnante Bai."], "tags": ["lezione-1b"] },
    { "hanzi": "请问，谁是白老师？", "pinyin": "Qǐngwèn, shéi shì Bái lǎoshī?", "italian": ["Scusi, chi è l'insegnante Bai?"], "tags": ["lezione-1b"] },
    { "hanzi": "我不是小云。", "pinyin": "Wǒ bú shì Xiǎoyún.", "italian": ["Non sono Xiaoyun."], "tags": ["lezione-1b"] },
    { "hanzi": "你是白老师吗？", "pinyin": "Nǐ shì Bái lǎoshī ma?", "italian": ["Sei l'insegnante Bai?"], "tags": ["lezione-1b"] },
    { "hanzi": "谁是王老师？", "pinyin": "Shéi shì Wáng lǎoshī?", "italian": ["Chi è l'insegnante Wang?"], "tags": ["lezione-1b"] },
    { "hanzi": "您是白老师吗？", "pinyin": "Nín shì Bái lǎoshī ma?", "italian": ["Lei è l'insegnante Bai?"], "tags": ["lezione-1b"] },
    { "hanzi": "请问，你叫什么名字？", "pinyin": "Qǐngwèn, nǐ jiào shénme míngzi?", "italian": ["Scusa, come ti chiami?"], "tags": ["lezione-1c"] },
    { "hanzi": "你叫什么名字？", "pinyin": "Nǐ jiào shénme míngzi?", "italian": ["Come ti chiami?"], "tags": ["lezione-1c"] },
    { "hanzi": "我叫马可。", "pinyin": "Wǒ jiào Mǎkě.", "italian": ["Mi chiamo Marco."], "tags": ["lezione-1c"] },
    { "hanzi": "我叫王一飞。", "pinyin": "Wǒ jiào Wáng Yīfēi.", "italian": ["Mi chiamo Wang Yifei."], "tags": ["lezione-1c"] },
    { "hanzi": "“王”是你的姓吗？", "pinyin": "“Wáng” shì nǐ de xìng ma?", "italian": ["«Wang» è il tuo cognome?"], "tags": ["lezione-1c"] },
    { "hanzi": "对。我姓王。", "pinyin": "Duì. Wǒ xìng Wáng.", "italian": ["Esatto. Di cognome mi chiamo Wang."], "tags": ["lezione-1c"] },
    { "hanzi": "他姓什么？", "pinyin": "Tā xìng shénme?", "italian": ["Qual è il suo cognome?"], "tags": ["lezione-1c"] },
    { "hanzi": "你多大？", "pinyin": "Nǐ duō dà?", "italian": ["Quanti anni hai?"], "tags": ["lezione-1c"] },
    { "hanzi": "她几岁？", "pinyin": "Tā jǐ suì?", "italian": ["Quanti anni ha (lei)?"], "tags": ["lezione-1c"] },
    { "hanzi": "我二十岁。", "pinyin": "Wǒ èrshí suì.", "italian": ["Ho vent'anni."], "tags": ["lezione-1c"] },
    { "hanzi": "我十五岁。", "pinyin": "Wǒ shíwǔ suì.", "italian": ["Ho quindici anni."], "tags": ["lezione-1c"] },
    { "hanzi": "她八岁。", "pinyin": "Tā bā suì.", "italian": ["Ha otto anni."], "tags": ["lezione-1c"] },
    { "hanzi": "请介绍一下儿，好吗？", "pinyin": "Qǐng jièshào yíxiàr, hǎo ma?", "italian": ["Per favore, fai le presentazioni, va bene?"], "tags": ["lezione-1d"] },
    { "hanzi": "你哥哥是大学生吗？", "pinyin": "Nǐ gēge shì dàxuéshēng ma?", "italian": ["Tuo fratello maggiore è uno studente universitario?"], "tags": ["lezione-1d"] },
    { "hanzi": "不是，他是中学生。", "pinyin": "Búshì, tā shì zhōngxuésheng.", "italian": ["No, è uno studente di scuola secondaria."], "tags": ["lezione-1d"] },
    { "hanzi": "我妈妈姓白。", "pinyin": "Wǒ māma xìng Bái.", "italian": ["Mia madre di cognome fa Bai."], "tags": ["lezione-1d"] },
    { "hanzi": "这是他姐姐。", "pinyin": "Zhè shì tā jiějie.", "italian": ["Questa è sua sorella maggiore."], "tags": ["lezione-1d"] },
    { "hanzi": "今年我八岁。", "pinyin": "Jīnnián wǒ bā suì.", "italian": ["Quest'anno ho otto anni."], "tags": ["lezione-1d"] },
    { "hanzi": "这是一飞的爸爸。", "pinyin": "Zhè shì Yīfēi de bàba.", "italian": ["Questo è il papà di Yifei."], "tags": ["lezione-1d"] },
    { "hanzi": "我是学生，他也是学生。", "pinyin": "Wǒ shì xuésheng, tā yě shì xuésheng.", "italian": ["Io sono studente e anche lui è studente."], "tags": ["lezione-1d"] },
    { "hanzi": "他们是一飞的爷爷和奶奶。", "pinyin": "Tāmen shì Yīfēi de yéye hé nǎinai.", "italian": ["Loro sono il nonno e la nonna (paterni) di Yifei."], "tags": ["lezione-1d"] },
    { "hanzi": "这是一飞的爸爸，这是他妈妈。", "pinyin": "Zhè shì Yīfēi de bàba, zhè shì tā māma.", "italian": ["Questo è il papà di Yifei, questa è sua mamma."], "tags": ["lezione-1d"] },
    { "hanzi": "你们是哪国人？", "pinyin": "Nǐmen shì nǎ guó rén?", "italian": ["Di che nazionalità siete?"], "tags": ["lezione-2a"] },
    { "hanzi": "我们是意大利人。", "pinyin": "Wǒmen shì Yìdàlì rén.", "italian": ["Siamo italiani."], "tags": ["lezione-2a"] },
    { "hanzi": "你是哪国人？", "pinyin": "Nǐ shì nǎ guó rén?", "italian": ["Di che nazionalità sei?"], "tags": ["lezione-2a"] },
    { "hanzi": "我是中国人。", "pinyin": "Wǒ shì Zhōngguó rén.", "italian": ["Sono cinese."], "tags": ["lezione-2a"] },
    { "hanzi": "你是哪儿的人？", "pinyin": "Nǐ shì nǎr de rén?", "italian": ["Di dove sei?"], "tags": ["lezione-2a"] },
    { "hanzi": "她们是哪儿的人？", "pinyin": "Tāmen shì nǎr de rén?", "italian": ["Di dove sono (loro)?"], "tags": ["lezione-2a"] },
    { "hanzi": "她们是米兰人。", "pinyin": "Tāmen shì Mǐlán rén.", "italian": ["Sono di Milano."], "tags": ["lezione-2a"] },
    { "hanzi": "她是罗马人，我是米兰人。", "pinyin": "Tā shì Luómǎ rén, wǒ shì Mǐlán rén.", "italian": ["Lei è di Roma, io sono di Milano."], "tags": ["lezione-2a"] },
    { "hanzi": "爱玛是罗马人，安娜是米兰人。", "pinyin": "Àimǎ shì Luómǎ rén, Ānnà shì Mǐlán rén.", "italian": ["Emma è di Roma, Anna è di Milano."], "tags": ["lezione-2a"] },
    { "hanzi": "我们都是意大利人。", "pinyin": "Wǒmen dōu shì Yìdàlì rén.", "italian": ["Siamo tutti italiani."], "tags": ["lezione-2a"] },
    { "hanzi": "你们都是意大利人吗？", "pinyin": "Nǐmen dōu shì Yìdàlì rén ma?", "italian": ["Siete tutti italiani?"], "tags": ["lezione-2a"] },
    { "hanzi": "不是。我们不都是意大利人。", "pinyin": "Bú shì, wǒmen bù dōu shì Yìdàlì rén.", "italian": ["No. Non siamo tutti italiani."], "tags": ["lezione-2a"] },
    { "hanzi": "他们都是白老师的学生。", "pinyin": "Tāmen dōu shì Bái lǎoshī de xuésheng.", "italian": ["Sono tutti studenti dell'insegnante Bai."], "tags": ["lezione-2a"] },
    { "hanzi": "他们都不是白老师的学生。", "pinyin": "Tāmen dōu bú shì Bái lǎoshī de xuésheng.", "italian": ["Nessuno di loro è studente dell'insegnante Bai."], "tags": ["lezione-2a"] },
    { "hanzi": "他们不都是白老师的学生。", "pinyin": "Tāmen bù dōu shì Bái lǎoshī de xuésheng.", "italian": ["Non tutti sono studenti dell'insegnante Bai."], "tags": ["lezione-2a"] },
    { "hanzi": "你是不是意大利人？", "pinyin": "Nǐ shì bu shì Yìdàlì rén?", "italian": ["Sei italiano (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "你们是学生吗？", "pinyin": "Nǐmen shì xuésheng ma?", "italian": ["Siete studenti?"], "tags": ["lezione-2a"] },
    { "hanzi": "你们是不是学生？", "pinyin": "Nǐmen shì bu shì xuésheng?", "italian": ["Siete studenti (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "请问，您是不是老师？", "pinyin": "Qǐngwèn, nín shì bu shì lǎoshī?", "italian": ["Mi scusi, Lei è insegnante (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "一飞是不是法国人？", "pinyin": "Yīfēi shì bu shì Fǎguó rén?", "italian": ["Yifei è francese (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "马可是不是米兰人？", "pinyin": "Mǎkě shì bu shì Mǐlán rén?", "italian": ["Marco è di Milano (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "张老师是不是意大利人？", "pinyin": "Zhāng lǎoshī shì bu shì Yìdàlì rén?", "italian": ["L'insegnante Zhang è italiano (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "小云是中国人。", "pinyin": "Xiǎoyún shì Zhōngguó rén.", "italian": ["Xiaoyun è cinese."], "tags": ["lezione-2a"] },
    { "hanzi": "她们是法国人。", "pinyin": "Tāmen shì Fǎguó rén.", "italian": ["Sono francesi."], "tags": ["lezione-2a"] },
    { "hanzi": "您呢？您是不是米兰人？", "pinyin": "Nín ne? Nín shì bu shì Mǐlán rén?", "italian": ["E Lei? È di Milano (o no)?"], "tags": ["lezione-2a"] },
    { "hanzi": "不是。我是威尼斯人。", "pinyin": "Bú shì. Wǒ shì Wēinísī rén.", "italian": ["No. Sono di Venezia."], "tags": ["lezione-2a"] },
    { "hanzi": "他不是意大利人，他是中国人。", "pinyin": "Tā bú shì Yìdàlì rén, tā shì Zhōngguó rén.", "italian": ["Non è italiano, è cinese."], "tags": ["lezione-2a"] },
    { "hanzi": "我来自都灵。", "pinyin": "Wǒ láizì Dūlíng.", "italian": ["Vengo da Torino."], "tags": ["lezione-2a"] },
    { "hanzi": "别的人都是外国人。", "pinyin": "Biéde rén dōu shì wàiguó rén.", "italian": ["Gli altri sono tutti stranieri."], "tags": ["lezione-2a"] },
    { "hanzi": "你住在哪儿？", "pinyin": "Nǐ zhù zài nǎr?", "italian": ["Dove abiti?"], "tags": ["lezione-2b"] },
    { "hanzi": "我住在北京。", "pinyin": "Wǒ zhù zài Běijīng.", "italian": ["Abito a Pechino."], "tags": ["lezione-2b"] },
    { "hanzi": "我不住在北京，我住在上海。", "pinyin": "Wǒ bú zhù zài Běijīng, wǒ zhù zài Shànghǎi.", "italian": ["Non abito a Pechino, abito a Shanghai."], "tags": ["lezione-2b"] },
    { "hanzi": "我住在北京，你也住在北京吧？", "pinyin": "Wǒ zhù zài Běijīng, nǐ yě zhù zài Běijīng ba?", "italian": ["Io abito a Pechino, anche tu abiti a Pechino, vero?"], "tags": ["lezione-2b"] },
    { "hanzi": "她住在南京路。", "pinyin": "Tā zhù zài Nánjīng lù.", "italian": ["Abita in via Nanchino."], "tags": ["lezione-2b"] },
    { "hanzi": "你是意大利人吧？", "pinyin": "Nǐ shì Yìdàlì rén ba?", "italian": ["Sei italiano, vero?"], "tags": ["lezione-2b"] },
    { "hanzi": "喂！你在哪儿？在教室吗？", "pinyin": "Wèi! Nǐ zài nǎr? Zài jiàoshì ma?", "italian": ["Pronto! Dove sei? Sei in aula?"], "tags": ["lezione-2b"] },
